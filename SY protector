-- UI Intrusion Feedback
if intrusionEvent then
	intrusionEvent.OnClientEvent:Connect(function(targetPlayer)
		if targetPlayer ~= LocalPlayer then
			statusLabel.Text = "Intruder: " .. targetPlayer.Name
			statusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
			task.delay(3, function()
				statusLabel.Text = "Status: Server Armed"
				statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
			end)
		end
	end)
end

----------------------------------------------------
-- LASER CAPE AIMBOT (Locks on when Cape is Equipped)
----------------------------------------------------
RunService.RenderStepped:Connect(function()
	if not aimbotEnabled then 
		local oldBeam = Workspace:FindFirstChild("SY_CapeLaserBeam")
		if oldBeam then oldBeam:Destroy() end
		return 
	end
	
	local char = LocalPlayer.Character
	if not char then return end
	
	-- Checks if LaserCape is equipped inside player character
	local cape = char:FindFirstChild(LASER_CAPE_NAME)
	if not cape then
		local oldBeam = Workspace:FindFirstChild("SY_CapeLaserBeam")
		if oldBeam then oldBeam:Destroy() end
		return
	end
	
	local myRoot = char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	
	-- Target Lock Finder
	local closestTarget = nil
	local shortestDist = 150
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local dist = (p.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
			if dist < shortestDist then
				shortestDist = dist
				closestTarget = p.Character
			end
		end
	end
	
	if closestTarget then
		local targetPart = closestTarget:FindFirstChild("HumanoidRootPart") or closestTarget:FindFirstChild("Head")
		local handle = cape:FindFirstChild("Handle") or cape:FindFirstChildOfClass("BasePart") or myRoot
		
		if targetPart and handle then
			local origin = handle.Position
			local targetPos = targetPart.Position
			local dist = (targetPos - origin).Magnitude
			
			local beam = Workspace:FindFirstChild("SY_CapeLaserBeam")
			if not beam then
				beam = Instance.new("Part")
				beam.Name = "SY_CapeLaserBeam"
				beam.BrickColor = BrickColor.new("Bright red")
				beam.Material = Enum.Material.Neon
				beam.CanCollide = false
				beam.Anchored = true
				beam.Parent = Workspace
			end
			
			beam.Size = Vector3.new(0.3, 0.3, dist)
			beam.CFrame = CFrame.new(origin, targetPos) * CFrame.new(0, 0, -dist / 2)
		end
	else
		local oldBeam = Workspace:FindFirstChild("SY_CapeLaserBeam")
		if oldBeam then oldBeam:Destroy() end
	end
end)
